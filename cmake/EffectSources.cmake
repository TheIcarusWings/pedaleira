# The built-in effects (plugin/src/effects) and the list that registers them.
#
#   include(cmake/EffectSources.cmake)
#   t3k_effect_sources(effect_sources)
#   target_sources(MyTarget PRIVATE ${effect_sources})
#
# Every .cpp under plugin/src/effects is compiled, so adding an effect needs
# no CMake edit. Each of them, except the helpers in a folder named dsp or
# detail, must define the hook
#
#   PEDALEIRA_EFFECT_KINDS(<FileStem>) { ... }     (effects/EffectRegistration.h)
#
# and this function writes BuiltinEffectKinds.gen.cpp, which names every hook.
# BlockKindRegistry calls them when it is first used. The list is generated
# rather than left to static initialisers on purpose: the plugin's shared code
# is a static library, and a linker is free to drop an object file nothing
# refers to, self-registering statics included (NAM needs a whole-archive
# link for exactly that reason). Here every effect file is referenced by
# name, so it cannot be dropped, and a file that forgets its hook is an
# undefined symbol at link time rather than a kind that is silently missing.
function(t3k_effect_sources out_var)
    set(effects_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../plugin/src/effects")
    get_filename_component(effects_dir "${effects_dir}" ABSOLUTE)

    # CONFIGURE_DEPENDS re-runs the glob at build time, so a new file is
    # picked up (and the list regenerated) without touching any CMake file.
    file(GLOB_RECURSE effect_sources CONFIGURE_DEPENDS "${effects_dir}/*.cpp")
    list(SORT effect_sources)

    set(hook_stems "")
    set(declarations "")
    set(entries "")
    foreach(source IN LISTS effect_sources)
        file(RELATIVE_PATH relative "${effects_dir}" "${source}")
        if (relative MATCHES "(^|/)(dsp|detail)/")
            continue()
        endif()
        get_filename_component(stem "${source}" NAME_WE)
        if (NOT stem MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
            message(FATAL_ERROR
                "Effect source '${relative}': the file name must be a C++ identifier, "
                "because its registration hook is named after it "
                "(PEDALEIRA_EFFECT_KINDS(${stem})).")
        endif()
        if (stem IN_LIST hook_stems)
            message(FATAL_ERROR
                "Effect source '${relative}': another effect file is already called "
                "'${stem}'. File names under plugin/src/effects must be unique across "
                "folders (helpers that register nothing go in a dsp/ or detail/ folder).")
        endif()
        list(APPEND hook_stems "${stem}")
        string(APPEND declarations "void registerKindsIn_${stem}(BlockKindRegistry&);\n")
        string(APPEND entries "      {\"${relative}\", &registerKindsIn_${stem}},\n")
    endforeach()

    set(generated "${CMAKE_BINARY_DIR}/generated/BuiltinEffectKinds.gen.cpp")
    string(CONCAT content
        "// Generated by cmake/EffectSources.cmake from the files under\n"
        "// plugin/src/effects. Do not edit: add or remove an effect file instead.\n"
        "#include \"effects/EffectRegistration.h\"\n"
        "\n"
        "${declarations}"
        "\n"
        "const std::vector<BuiltinEffectHook>& builtinEffectHooks() {\n"
        "  static const std::vector<BuiltinEffectHook> hooks = {\n"
        "${entries}"
        "  };\n"
        "  return hooks;\n"
        "}\n")
    # Only rewritten when the list changes, so a reconfigure does not rebuild
    # it. Several targets call this function; they all write the same text.
    set(previous "")
    if (EXISTS "${generated}")
        file(READ "${generated}" previous)
    endif()
    if (NOT previous STREQUAL content)
        file(WRITE "${generated}" "${content}")
    endif()

    set(${out_var} ${effect_sources} "${generated}" PARENT_SCOPE)
endfunction()
