{
  "format": "pedaleira-amp",
  "version": 1,

  "metadata": {
    "name": "High Gain (wave digital)",
    "author": "Pedaleira",
    "licence": "MIT",
    "summary": "A modern four-stage high gain preamp (a 12AX7 input stage, a gain pot with a bright cap, three cascaded gain stages, a treble-middle-bass tone stack) into a push-pull EL34 power amp with presence and depth feedback and a sagging supply. A typical topology of the genre, not the schematic of one product: the component values are the usual ones for this circuit, and what was chosen by ear or by fitting is marked \"fitted\". This file is the same amp as high-gain.json with the gain stages solved as wave digital filters (the plate load, the coupling into the next grid, the cathode network and the gain pot as WDF trees, the tube as a nonlinear root); the plate networks load each other as the real circuit does, so it plays a little lower in level (about 0.3 dB at the defaults) and the first stage's cathode feedback sets in where the circuit puts it.",
    "references": [
      "D. T. Yeh and J. O. Smith, Discretization of the '59 Fender Bassman Tone Stack, DAFx-06, 2006",
      "J. Pakarinen and D. T. Yeh, A review of digital techniques for modeling vacuum-tube guitar amplifiers, Computer Music Journal 33(2), 2009"
    ]
  },

  "model": { "stage_solver": "wdf" },

  "input": {
    "coupling_capacitor_f": 6.8e-9,
    "grid_leak_ohm": 1.0e6,
    "grid_stopper_ohm": 68000,
    "miller_f": 160e-12,
    "source_ohm": { "value": 10000, "provenance": "fitted", "note": "assumed pickup impedance for the grid charge path" }
  },

  "stages": [
    {
      "name": "V1 input stage",
      "tube": "12AX7",
      "plate_load_ohm": 100000,
      "plate_capacitance_f": { "value": 295e-12, "provenance": "fitted", "note": "wiring plus the next Miller capacitance; sets the stage's high-frequency roll-off" },
      "cathode": { "resistor_ohm": 1500, "bias_current_a": 0.001, "bypass_capacitor_f": 0.68e-6 },
      "grid": { "cutoff_v": 3.5, "contact_potential_v": 0.3, "conduction_ohm": 2000, "max_bias_shift_v": 10 },
      "coupling": { "series_ohm": 0, "grid_leak_ohm": 470000 },
      "gain_pot": {
        "resistance_ohm": 1.0e6,
        "floor_ohm": 22000,
        "source_ohm": 100000,
        "load_ohm": 470000,
        "taper": 3.3,
        "bright_capacitor_f": 100e-12
      }
    },
    {
      "name": "V2 gain stage",
      "tube": "12AX7",
      "plate_load_ohm": 100000,
      "plate_capacitance_f": { "value": 345e-12, "provenance": "fitted", "note": "wiring plus the next Miller capacitance" },
      "cathode": { "resistor_ohm": 1500, "bias_current_a": 0.001, "bypass_capacitor_f": "ideal" },
      "coupling": { "series_ohm": 470000, "grid_leak_ohm": 25000 }
    },
    {
      "name": "V3 gain stage",
      "tube": "12AX7",
      "plate_load_ohm": 100000,
      "plate_capacitance_f": { "value": 413e-12, "provenance": "fitted", "note": "wiring plus the next Miller capacitance" },
      "cathode": { "resistor_ohm": 1500, "bias_current_a": 0.001, "bypass_capacitor_f": "ideal" },
      "coupling": { "series_ohm": 470000, "grid_leak_ohm": 10000 }
    },
    {
      "name": "V4 gain stage",
      "tube": "12AX7",
      "plate_load_ohm": 100000,
      "plate_capacitance_f": { "value": 459e-12, "provenance": "fitted", "note": "wiring plus the next Miller capacitance" },
      "cathode": { "resistor_ohm": 1500, "bias_current_a": 0.001, "bypass_capacitor_f": "ideal" }
    }
  ],

  "voicings": [
    {
      "name": "Tight",
      "coupling_capacitors_f": [4.7e-9, 2.7e-9, 2.0e-9],
      "supply": { "source_ohm": { "value": 100, "provenance": "fitted", "note": "a stiff solid-state supply" }, "rectifier": "solid_state" }
    },
    {
      "name": "Classic",
      "coupling_capacitors_f": [8.2e-9, 4.7e-9, 3.9e-9],
      "supply": { "source_ohm": { "value": 250, "provenance": "fitted", "note": "tube rectifier and transformer resistance" }, "rectifier": "tube" }
    },
    {
      "name": "Loose",
      "coupling_capacitors_f": [15e-9, 10e-9, 8.2e-9],
      "supply": { "source_ohm": { "value": 450, "provenance": "fitted", "note": "a soft supply with a large source resistance" }, "rectifier": "tube" }
    }
  ],
  "default_voicing": 1,

  "tone_stack": {
    "type": "tmb",
    "treble_pot_ohm": 220000,
    "bass_pot_ohm": 1.0e6,
    "middle_pot_ohm": 22000,
    "slope_ohm": 39000,
    "treble_cap_f": 400e-12,
    "bass_cap_f": 22e-9,
    "middle_cap_f": 22e-9
  },

  "effects_loop": { "present": false, "note": "placeholder: the signal does not pass through a loop" },

  "power_amp": {
    "tube": "EL34",
    "topology": "push_pull_ab",
    "open_loop_gain": 20,
    "feedback": { "series_ohm": 4000, "shunt_ohm": 1000 },
    "presence": { "pot_ohm": 5000, "min_ohm": 220, "capacitor_f": 47e-9 },
    "depth": { "inductance_h": 0.12, "capacitance_f": 21e-6, "resistance_ohm": 63, "max_cut": 0.85 },
    "transformer": { "high_corner_hz": 9000, "low_corner_hz": 12 },
    "knee_mix": 0.0,
    "crossover": { "ratio": 0.9, "width": 0.3 },
    "supply": {
      "b_plus_v": 450,
      "source_ohm": 250,
      "full_load_a": 0.3,
      "reservoir_f": 220e-6,
      "attack_s": 0.008,
      "rectifier": "tube"
    }
  },

  "calibration": {
    "input_full_scale_v": 2.0,
    "power_drive_v": 40,
    "coupling_gain_rise": 1.8,
    "output_trim": 0.2,
    "control_smoothing_s": 0.02
  },

  "panel": {
    "gain": { "label": "Gain", "target": "stages[0].gain_pot" },
    "bass": { "label": "Bass", "target": "tone_stack.bass_pot_ohm", "taper": 2.0 },
    "middle": { "label": "Middle", "target": "tone_stack.middle_pot_ohm" },
    "treble": { "label": "Treble", "target": "tone_stack.treble_pot_ohm" },
    "presence": { "label": "Presence", "target": "power_amp.presence" },
    "depth": { "label": "Depth", "target": "power_amp.depth" },
    "master": { "label": "Master", "target": "master", "taper": 2.0 },
    "bright": { "label": "Bright", "target": "stages[0].gain_pot.bright_capacitor_f" },
    "voicing": { "label": "Voicing", "target": "voicings" }
  },

  "default_cab": {"speaker": "Granite", "size": "4x12", "back": "closed", "mic": "dynamic",
                  "position_percent": 35, "distance_cm": 2.5}
}
