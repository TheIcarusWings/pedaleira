{
  "source": "quad-cortex",
  "version": 1,
  "description": "Quad Cortex block names and parameters onto Pedaleira kinds. Built from public sources only (docs/import.md, 'Sources'). Nothing here has been checked against a dump from a real unit yet: every model is verified false, and a parameter with a unit is only taken when the dump gives that unit.",
  "models": {
    "VCA Comp": {
      "kind": "dynamics.compressor",
      "verified": false,
      "params": {
        "THRESHOLD": { "param": "thresholdDb", "unit": "dB", "transform": "linear" }
      },
      "notes": "THRESHOLD in dB is the one name pyquadcortex's documentation gives for this block. The unit runs -60 to +12 dB, ours -60 to 0, so a value above 0 is clamped and reported. Ratio, attack, release and the rest stay at our defaults until their names are known."
    },
    "Simple Gate": {
      "kind": "dynamics.gate",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },
    "Utility Gate": {
      "kind": "dynamics.gate",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },
    "Adaptive Gate": {
      "kind": "dynamics.gate",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },
    "Graphic 9": {
      "kind": "eq.graphic10",
      "verified": false,
      "notes": "Nine bands against our ten at other centre frequencies, and the band names are unknown: placed flat. Set the bands by ear."
    },

    "Digital Delay": {
      "kind": "delay.digital",
      "verified": false,
      "params": {
        "FEEDBACK": { "param": "feedback", "unit": "%", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "FEEDBACK and MIX are the manual's common delay controls; the percent units are assumed. The time is not mapped yet (its name and units are unconfirmed)."
    },
    "Analog Delay": {
      "kind": "delay.analog",
      "verified": false,
      "params": {
        "FEEDBACK": { "param": "feedback", "unit": "%", "transform": "linear" },
