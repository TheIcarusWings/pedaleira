{
  "source": "quad-cortex",
  "version": 1,
  "description": "Quad Cortex block names and parameters onto Pedaleira kinds. Built from public sources only (docs/import.md, 'Sources'). Nothing here has been checked against a dump from a real unit yet: every model is verified false, and a parameter with a unit is only taken when the dump gives that unit.",
  "models": {
    "VCA Comp": {
      "kind": "dynamics.compressor",
      "verified": false,
      "params": {
        "THRESHOLD": { "param": "thresholdDb", "unit": "dB", "transform": { "scale": 1, "offset": -1.28 } },
        "RATIO": { "param": "ratio", "transform": "linear" },
        "MAKEUP": { "param": "makeupDb", "transform": "linear" },
        "ATTACK": { "param": "attackMs", "transform": "linear" },
        "RELEASE": { "param": "releaseMs", "transform": "linear" }
      },
      "notes": "The unit runs THRESHOLD -60 to +12 dB, ours -60 to 0, so a value above 0 is clamped and reported. Measured on a unit (CorOS d14e): the unit compresses from 1.28 dB below the threshold it shows (-1.23 to -1.36 over five takes at -20 and -30), hence the offset; RATIO matches exactly. ATTACK and RELEASE take the dump's real times (quad-cortex-curves.json), but the unit's envelope is shaped differently from ours, so the timing is close, not equal."
    },
    "Simple Gate": {
      "kind": "dynamics.gate",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },
    "Utility Gate": {
      "kind": "dynamics.gate",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },
    "Adaptive Gate": {
      "kind": "dynamics.gate",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },
    "Graphic 9": {
      "kind": "eq.graphic10",
      "verified": false,
      "notes": "Nine bands against our ten at other centre frequencies, and the band names are unknown: placed flat. Set the bands by ear."
    },

    "Digital Delay": {
      "kind": "delay.digital",
      "verified": false,
      "params": {
        "DELAY TIME": { "param": "timeMs", "unit": "ms", "transform": "linear" },
        "SYNC": { "param": "sync", "transform": "linear" },
        "FEEDBACK": { "param": "feedback", "unit": "%", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Names and units from a unit's catalogue (CorOS d14e), as Digital Delay (M) and (ST): DELAY TIME 7 to 6000 ms, SYNC on by default (then the time follows SYNC NOTE), FEEDBACK and MIX in percent. Not yet measured against the unit's sound."
    },
    "Analog Delay": {
      "kind": "delay.analog",
      "verified": false,
      "params": {
        "FEEDBACK": { "param": "feedback", "unit": "%", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Feedback and mix only; the time is not mapped."
    },
    "Tape Delay": {
      "kind": "delay.tape",
      "verified": false,
      "params": {
        "FEEDBACK": { "param": "feedback", "unit": "%", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Feedback and mix only; the time, wow, flutter and drive are not mapped."
    },
    "Simple Delay": {
      "kind": "delay.simple",
      "verified": false,
      "params": {
        "FEEDBACK": { "param": "feedback", "unit": "%", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Feedback and mix only; the time is not mapped."
    },
    "Simple Ping Pong Delay": {
      "kind": "delay.pingpong",
      "verified": false,
      "params": {
        "FEEDBACK": { "param": "feedback", "unit": "%", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Feedback and mix only; the time is not mapped."
    },

    "Room": {
      "kind": "reverb.room",
      "verified": false,
      "params": {
        "PRE DELAY": { "param": "preDelayMs", "unit": "ms", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Pre delay (up to 100 ms in the manual) and mix. Decay and the filters are not mapped: their names and units are unconfirmed."
    },
    "Hall": {
      "kind": "reverb.hall",
      "verified": false,
      "params": {
        "DECAY": { "param": "decayS", "unit": "s", "transform": "linear" },
        "PRE DELAY": { "param": "preDelayMs", "unit": "ms", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Decay, pre delay and mix; the filters are not mapped. The unit's catalogue (CorOS d14e) gives DECAY 1 to 10 s and PRE DELAY 1 to 100 ms."
    },
    "Plate": {
      "kind": "reverb.plate",
      "verified": false,
      "params": {
        "PRE DELAY": { "param": "preDelayMs", "unit": "ms", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Pre delay and mix only; decay and the filters are not mapped."
    },
    "Plate Lush": {
      "kind": "reverb.plate",
      "verified": false,
      "params": {
        "PRE DELAY": { "param": "preDelayMs", "unit": "ms", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "A variant of Plate; ours has one plate."
    },
    "Plate Tight": {
      "kind": "reverb.plate",
      "verified": false,
      "params": {
        "PRE DELAY": { "param": "preDelayMs", "unit": "ms", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "A variant of Plate; ours has one plate."
    },
    "Shimmer": {
      "kind": "reverb.shimmer",
      "verified": false,
      "params": {
        "PRE DELAY": { "param": "preDelayMs", "unit": "ms", "transform": "linear" },
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Pre delay and mix only; decay and the filters are not mapped."
    },
    "Spring": {
      "kind": "reverb.spring",
      "verified": false,
      "params": {
        "MIX": { "param": "mix", "unit": "%", "transform": { "scale": 0.01, "offset": 0 } }
      },
      "notes": "Mono and stereo versions are one model here. Only the mix is mapped."
    },

    "Vintage Chorus": {
      "kind": "modulation.chorus",
      "verified": false,
      "params": {
        "CHR RATE": { "param": "rateHz", "unit": "Hz", "transform": "linear" }
      },
      "notes": "The unit's catalogue (CorOS d14e) has no RATE or DEPTH here: a chorus rate CHR RATE (0.3 to 3 Hz) and a vibrato section (VIB RATE, VIB DEPTH) beside MIX, WIDTH and MODE. Only the chorus rate is mapped."
    },
    "Chorus Engine": {
      "kind": "modulation.chorus",
      "verified": false,
      "params": {
        "RATE": { "param": "rateHz", "unit": "Hz", "transform": "linear" },
        "DEPTH": { "param": "depth", "unit": "%", "transform": "linear" }
      },
      "notes": "Rate and depth only."
    },
    "Digital Flanger": {
      "kind": "modulation.flanger",
      "verified": false,
      "params": {
        "RATE": { "param": "rateHz", "unit": "Hz", "transform": "linear" },
        "DEPTH": { "param": "depth", "unit": "%", "transform": "linear" }
      },
      "notes": "Rate and depth only."
    },
    "Flanger Engine": {
      "kind": "modulation.flanger",
      "verified": false,
      "params": {
        "RATE": { "param": "rateHz", "unit": "Hz", "transform": "linear" },
        "DEPTH": { "param": "depth", "unit": "%", "transform": "linear" }
      },
      "notes": "Rate and depth only."
    },
    "Flangerish": {
      "kind": "modulation.flanger",
      "verified": false,
      "params": {
        "RATE": { "param": "rateHz", "unit": "Hz", "transform": "linear" },
        "DEPTH": { "param": "depth", "unit": "%", "transform": "linear" }
      },
      "notes": "Rate and depth only."
    },
    "Phaser": {
      "kind": "modulation.phaser",
      "verified": false,
      "params": {
        "DEPTH": { "param": "depth", "unit": "%", "transform": "linear" }
      },
      "notes": "The unit's catalogue (CorOS d14e) has no RATE: its speed is SPEED, 0 to 100 with no unit, so it is not mapped to our rate in Hz. DEPTH is on one of the two Phaser models only."
    },
    "Tremolo": {
      "kind": "modulation.tremolo",
      "verified": false,
      "params": {
        "RATE": { "param": "rateHz", "unit": "Hz", "transform": "linear" },
        "DEPTH": { "param": "depth", "unit": "%", "transform": "linear" }
      },
      "notes": "Rate and depth only."
    },
    "Vibrato": {
      "kind": "modulation.vibrato",
      "verified": false,
      "params": {
        "RATE": { "param": "rateHz", "unit": "Hz", "transform": "linear" }
      },
      "notes": "Rate only: ours sets the depth in cents, and the unit of theirs is unconfirmed."
    },
    "Rotary": {
      "kind": "modulation.rotary",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },

    "Envelope Filter": {
      "kind": "filter.envelope",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },
    "Auto Wah": {
      "kind": "filter.autowah",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },

    "Pitch Shifter": {
      "kind": "pitch.shifter",
      "verified": false,
      "notes": "Parameters not mapped: names unknown."
    },
    "Poly Octaver": {
      "kind": "pitch.octaver",
      "verified": false,
      "notes": "Parameters not mapped: names unknown. Ours is not polyphonic."
    }
  },
